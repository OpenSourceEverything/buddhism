SITE_NAME=freebuddhism_web
NGINX_IMAGE=nginx:alpine
VIRTUAL_HOSTNAME=freebuddhism.org,www.freebuddhism.org
LETSENCRYPT_DOMAIN=freebuddhism.org,www.freebuddhism.org
HTTPS_METHOD_TYPE=redirect
PROXY_NETWORK=server-nginx_default
HEALTHCHECK_ENABLED=no
HEALTHCHECK_URL=http://127.0.0.1/
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=3s
HEALTHCHECK_RETRIES=3
